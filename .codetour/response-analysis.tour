{
  "$schema": "../.vscode/codetour.schema.json",
  "title": "Аналіз відповідей користувача",
  "steps": [
    {
      "file": "core/response_analysis/models.py",
      "line": 1,
      "description": "Модуль визначає категорії відповідей, стани діалогу, структуру результату аналізу та модель патернів, які зберігаються у сховищі."
    },
    {
      "file": "core/response_analysis/config.py",
      "line": 1,
      "description": "Файл містить пороги впевненості семантичного аналізу та обмеження на довжину фраз, які можуть бути запропоновані для збереження."
    },
    {
      "file": "core/response_analysis/repository.py",
      "line": 1,
      "description": "Репозиторій створює таблицю патернів, додає базовий набір відповідей під час першого запуску та надає методи читання і зміни записів."
    },
    {
      "file": "core/response_analysis/text_normalizer.py",
      "line": 1,
      "description": "Нормалізатор приводить текст до уніфікованого вигляду: переводить літери до нижнього регістру та усуває надлишкові пробіли й частину пунктуації."
    },
    {
      "file": "core/response_analysis/pattern_matcher.py",
      "line": 1,
      "description": "Зіставлювач порівнює нормалізовану відповідь із патернами у сховищі та повертає категорію для точного або часткового збігу."
    },
    {
      "file": "core/response_analysis/semantic_analyzer.py",
      "line": 1,
      "description": "Якщо правила та патерни не дали результату, аналізатор оцінює семантичну схожість відповіді з відомими фразами. За наявності може використовувати sentence-transformers; інакше застосовується резервне векторне подання."
    },
    {
      "file": "core/response_analysis/decision_engine.py",
      "line": 1,
      "description": "Механізм прийняття рішення застосовує нормалізовані короткі відповіді, правила заперечення, патерни та семантичну оцінку. Наприклад, фраза «так, але не зараз» класифікується як відмова."
    },
    {
      "file": "core/response_analysis/response_analyzer.py",
      "line": 1,
      "description": "Аналізатор приймає запитання, відповідь і контекст діалогу та передає їх механізму прийняття рішення. Виконання відповідної дії контролюється окремо логікою асистента."
    },
    {
      "file": "core/response_analysis/response_learner.py",
      "line": 1,
      "description": "Компонент перевіряє, чи може нова коротка фраза стати кандидатом для навчання. Фраза зберігається лише після явного підтвердження користувача."
    },
    {
      "file": "tests/test_response_analysis.py",
      "line": 1,
      "description": "Набір тестів перевіряє нормалізацію, класифікацію коротких і складених відповідей, обробку невизначеності та кероване збереження нових патернів."
    }
  ]
}

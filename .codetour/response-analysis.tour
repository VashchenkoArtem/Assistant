{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Розбираємо response_analysis",
  "steps": [
    {
      "file": "core/response_analysis/models.py",
      "line": 1,
      "description": "Почни звідси: тут описані основні дані модуля — згода, відмова, стани діалогу, результат аналізу та патерн, який зберігається в базі."
    },
    {
      "file": "core/response_analysis/config.py",
      "line": 1,
      "description": "Тут налаштовуються пороги впевненості та обмеження для коротких фраз. Якщо аналізатор надто часто відповідає UNKNOWN, спершу подивись на ці значення."
    },
    {
      "file": "core/response_analysis/repository.py",
      "line": 1,
      "description": "Це єдине місце, де модуль працює з базою. Repository створює таблицю, додає початкові «так» і «ні» та дає методи для роботи з патернами."
    },
    {
      "file": "core/response_analysis/text_normalizer.py",
      "line": 1,
      "description": "Перед пошуком фраз текст приводиться до спільного вигляду: наприклад, забираються зайві пробіли й великі літери."
    },
    {
      "file": "core/response_analysis/pattern_matcher.py",
      "line": 1,
      "description": "Тут перевіряється, чи є відповідь у знайомому словнику. Точному збігу довіряємо більше, ніж припущенню семантичної моделі."
    },
    {
      "file": "core/response_analysis/semantic_analyzer.py",
      "line": 1,
      "description": "Якщо знайому фразу не знайдено, цей клас кодує відповідь і патерни у вектори та порівнює їх через NumPy. Перший запуск може завантажувати модель."
    },
    {
      "file": "core/response_analysis/decision_engine.py",
      "line": 1,
      "description": "Це арбітр між словником, семантичною оцінкою та простими правилами заперечення. Саме тут вирішується, що робити з фразою «так, але не зараз»."
    },
    {
      "file": "core/response_analysis/response_analyzer.py",
      "line": 1,
      "description": "Головна точка входу: приймає запитання, відповідь і контекст, а повертає результат. Сам асистент має окремо вирішити, чи виконувати дію."
    },
    {
      "file": "core/response_analysis/response_learner.py",
      "line": 1,
      "description": "Тут можна підготувати коротку нову фразу-кандидат. Вона не потрапить у базу, доки код явно не викличе accept_candidate."
    },
    {
      "file": "tests/test_response_analysis.py",
      "line": 1,
      "description": "Тести показують, як модуль поводиться на прикладах: очищення тексту, пошук патернів, заперечення та збереження коротких кандидатів."
    }
  ]
}

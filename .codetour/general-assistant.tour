{
  "$schema": "../.vscode/codetour.schema.json",
  "title": "Можливості голосового асистента",
  "steps": [
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 42,
      "description": "Це основна точка запуску асистента як команди Django. Тут створюються об'єкти аналізу відповідей і задається початковий стан роботи."
    },
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 59,
      "description": "Асистент отримує аудіо з мікрофона та передає його сервісу розпізнавання мовлення з українською локаллю. Параметри розпізнавача задають тривалість пауз і межі запису."
    },
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 113,
      "description": "Диспетчер команд розпізнає підтримувані звернення: привітання, перегляд переліку програм, відкриття й закриття програм, а також керування станом асистента."
    },
    {
      "file": "utils/list_apps.py",
      "line": 48,
      "description": "Модуль формує перелік встановлених програм, скануючи типові системні каталоги. У Windows додатково отримуються записи програм із меню «Пуск», зокрема програм Microsoft Store."
    },
    {
      "file": "utils/match_app.py",
      "line": 42,
      "description": "Пошук зіставляє назву з переліком доступних програм, враховує транслітерацію та неточні збіги. Якщо результати неоднозначні або недостатньо схожі, програма не вибирається."
    },
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 189,
      "description": "Для невідомої або нової програми асистент уточнює розпізнану назву перед виконанням дії. Відмову можна використати, щоб подати назву повторно; невизначена відповідь не призводить до виконання."
    },
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 247,
      "description": "Якщо розпізнано нову відповідну фразу, асистент може запропонувати зберегти її як патерн. Збереження відбувається лише після окремого підтвердження користувача."
    },
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 295,
      "description": "Керування станом підтримує паузу, відновлення роботи та зупинку асистента. Під час паузи обробляються команди відновлення або зупинки."
    },
    {
      "file": "core/management/commands/run_assistant.py",
      "line": 315,
      "description": "Після визначення програми асистент виконує відкриття або закриття засобами операційної системи. Підтримуються Windows, macOS і Linux; конкретний механізм залежить від системи."
    },
    {
      "file": "utils/voicing_answer.py",
      "line": 1,
      "description": "Голосові повідомлення синтезуються через Edge TTS українським голосовим профілем і відтворюються через pygame. Черга та блокування координують відтворення і запис аудіо."
    },
    {
      "file": "core/models.py",
      "line": 6,
      "description": "Модель AppCommand зберігає назви й шляхи програм, їхні категорії та ознаку автоматичної реєстрації. Лічильник запусків оновлюється після успішного відкриття."
    },
    {
      "file": "tests/test_run_assistant_response_flow.py",
      "line": 1,
      "description": "Інтеграційні тести перевіряють сценарії керування асистентом, підтвердження назв програм, голосове відтворення та безпечну обробку невизначених відповідей."
    }
  ]
